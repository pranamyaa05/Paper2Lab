{
  "name": "paper2lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "registry": "UPDATE_REGISTRY=1 vitest run src/labs/registry.test.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "test:backend": "cd backend && .venv/bin/pytest -q"
  },
  "dependencies": {
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vite": "8.1.7",
    "vitest": "^4.1.12"
  }
}
