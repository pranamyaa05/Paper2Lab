# Paper2Lab runs in demo mode with no keys. Add any of these to a file named .env to switch on the real AI.
# Keys stay on the dev server (server/api.ts); they are never sent to the browser.

# Google Gemini: reads the diagram, builds the simulation spec, answers "Ask your diagram", translates narration.
GEMINI_API_KEY=
# Backup model. Lite models are tried first: the bigger Flash models allow only ~20 free requests a day.
GEMINI_MODEL=gemini-3.8-flash
# Requests per minute the app allows itself (free tier: keep it low).
GEMINI_RPM=8

# ElevenLabs: natural multilingual voice. Without it the browser's built-in voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
